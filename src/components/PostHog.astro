---
// PostHog snippet. Activates when PUBLIC_POSTHOG_KEY is set in env.
// In dev, leave it unset so local browsing doesn't pollute prod data.
//
// PostHog handles both analytics (autocapture, pageviews) and
// experiments (feature flags + A/B). To run an experiment:
//   1. Create it in the PostHog dashboard, define a feature flag.
//   2. In the dashboard's visual editor, target the element to modify
//      and define variant copy. PostHog swaps the variant client-side.
//   3. Define a conversion event (e.g. download CTA click — set up via
//      data-attribute or class targeted in autocapture rules).
//
// For data-attribute-based event capture (recommended for CTAs):
//   <a data-ph-capture-attribute-cta="hero-ios" href="..."/>
// will appear in autocapture with the cta=hero-ios property.

const apiKey = import.meta.env.PUBLIC_POSTHOG_KEY;
// `||` not `??`: when a GitHub Actions secret doesn't exist, the env var
// is substituted as an empty string (not undefined), so nullish-coalescing
// wouldn't fall through to the EU default.
const apiHost = import.meta.env.PUBLIC_POSTHOG_HOST || 'https://eu.i.posthog.com';
---

{apiKey && (
  <script is:inline define:vars={{ apiKey, apiHost }}>
