---
// Renders App Store + Play buttons side by side. Play renders as a
// disabled "Coming soon" pill until STORES.PLAY_STORE_URL is set, then
// becomes a real link automatically.
//
// `location` prop becomes the `cta` property on PostHog autocapture
// events so you can attribute conversions to which CTA was clicked
// (hero vs nav vs final).

import { STORES } from '~/consts';

interface Props {
  /** Identifier passed to PostHog autocapture for attribution. */
  location: string;
  variant?: 'primary' | 'secondary';
}

const { location, variant = 'primary' } = Astro.props;
const iosClass = variant === 'primary' ? 'dl-btn dl-btn-primary' : 'dl-btn dl-btn-secondary';
---

<a
  class={iosClass}
  href={STORES.APP_STORE_URL}
  data-ph-capture-attribute-cta={`${location}-ios`}
  rel="noopener"
>
  <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M17.05 12.04c-.03-2.74 2.24-4.06 2.34-4.13-1.27-1.86-3.26-2.12-3.96-2.15-1.69-.17-3.3 1-4.16 1-.87 0-2.19-.97-3.6-.94-1.85.03-3.55 1.07-4.5 2.72-1.92 3.32-.49 8.25 1.38 10.95.92 1.32 2.01 2.81 3.43 2.76 1.38-.06 1.9-.89 3.57-.89s2.14.89 3.6.86c1.49-.03 2.43-1.34 3.34-2.67 1.06-1.53 1.49-3.02 1.51-3.1-.03-.01-2.91-1.11-2.95-4.41M14.4 3.91c.74-.91 1.25-2.16 1.11-3.41-1.07.05-2.39.72-3.16 1.61-.69.79-1.31 2.08-1.15 3.3 1.2.09 2.43-.61 3.2-1.5"/>
  </svg>
  <span class="label">
    <span class="label-top">Download on the</span>
    <span class="label-bottom">App Store</span>
  </span>
</a>

{STORES.PLAY_STORE_URL ? (
  <a
    class="dl-btn dl-btn-secondary"
    href={STORES.PLAY_STORE_URL}
    data-ph-capture-attribute-cta={`${location}-android`}
    rel="noopener"
  >
    <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M3.9 1.6C3.5 1.8 3.3 2.3 3.3 3v18c0 .7.2 1.2.6 1.4l10.2-9.7L3.9 1.6m1.4 21.2L17 11.2 14.5 8.7 5.3 22.8m13.3-12L21.7 9c.4-.2.7-.6.7-1s-.3-.8-.7-1l-3.1-1.8L15.7 8.7l2.9 2.1M15.7 13.3 18.6 16l3.1-1.8c.4-.2.7-.6.7-1s-.3-.8-.7-1l-3.1-1.8-2.9 2.9"/>
    </svg>
    <span class="label">
      <span class="label-top">Get it on</span>
      <span class="label-bottom">Google Play</span>
    </span>
  </a>
) : (
  <a
    class="dl-btn dl-btn-disabled"
    href={STORES.ANDROID_WAITLIST_URL}
    data-ph-capture-attribute-cta={`${location}-android-waitlist`}
  >
    <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M3.9 1.6C3.5 1.8 3.3 2.3 3.3 3v18c0 .7.2 1.2.6 1.4l10.2-9.7L3.9 1.6m1.4 21.2L17 11.2 14.5 8.7 5.3 22.8m13.3-12L21.7 9c.4-.2.7-.6.7-1s-.3-.8-.7-1l-3.1-1.8L15.7 8.7l2.9 2.1M15.7 13.3 18.6 16l3.1-1.8c.4-.2.7-.6.7-1s-.3-.8-.7-1l-3.1-1.8-2.9 2.9"/>
    </svg>
    <span class="label">
      <span class="label-top">Coming to</span>
      <span class="label-bottom">Google Play</span>
    </span>
  </a>
)}
