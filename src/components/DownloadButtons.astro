---
// Store-button block. Two variants:
//   variant="hero"  → App Store (live) + Android (ghost "Coming soon")
//   variant="final" → App Store only
//
// Both push a `cta=<location>-<store>` attribute that PostHog autocapture
// picks up — so you can attribute downloads to which CTA was clicked.

import { STORES } from '~/consts';

interface Props {
  location: string;
  variant?: 'hero' | 'final';
}

const { location, variant = 'hero' } = Astro.props;
---

<div class="hero__stores">
  <a
    class="store-btn"
    href={STORES.APP_STORE_URL}
    target="_blank"
    rel="noopener"
    data-ph-capture-attribute-cta={`${location}-ios`}
  >
    <svg viewBox="0 0 384 512" fill="currentColor" aria-hidden="true">
      <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z" />
    </svg>
    <span>
      <span class="store-btn__small">Download on the</span>
      <span class="store-btn__big">App Store</span>
    </span>
  </a>

  {variant === 'hero' && (
    <a
      class="store-btn store-btn--ghost"
      href={STORES.PLAY_STORE_URL ?? STORES.ANDROID_WAITLIST_URL}
      aria-disabled={STORES.PLAY_STORE_URL ? undefined : 'true'}
      data-ph-capture-attribute-cta={`${location}-android${STORES.PLAY_STORE_URL ? '' : '-waitlist'}`}
    >
      <svg viewBox="0 0 512 512" fill="currentColor" aria-hidden="true">
        <path d="M325.3 234.3L104.4 38.3c-4-3.6-9.6-4.5-14.5-2.4-4.9 2.1-8.1 6.9-8.1 12.2v416c0 5.3 3.2 10.1 8.1 12.2 4.9 2.1 10.5 1.2 14.5-2.4l220.9-196c4.3-3.8 6.7-9.3 6.7-15v-14c0-5.7-2.4-11.2-6.7-15zm99.1 75.5L357.3 256l66.9-53.8c6.2-5 14.5-5.8 21.4-2l56.5 31.2c15.7 8.6 15.7 31.7 0 40.3l-56.5 31.2c-6.9 3.8-15.2 3-21.4-2z" />
      </svg>
      <span>
        <span class="store-btn__small">Android —</span>
        <span class="store-btn__big">{STORES.PLAY_STORE_URL ? 'Google Play' : 'Coming soon'}</span>
      </span>
    </a>
  )}
</div>
